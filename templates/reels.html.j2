<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<title>Bugün Samsun · Reels</title>
<style>
@font-face { font-family: "Libron"; src: url("{{ assets }}/fonts/Libron-Regular.ttf"); font-weight: 100 500; font-style: normal; }
@font-face { font-family: "Libron"; src: url("{{ assets }}/fonts/Libron-Bold.ttf"); font-weight: 600 900; font-style: normal; }
@font-face { font-family: "Libron"; src: url("{{ assets }}/fonts/Libron-Italic.ttf"); font-weight: 100 500; font-style: italic; }
@font-face { font-family: "Libron"; src: url("{{ assets }}/fonts/Libron-BoldItalic.ttf"); font-weight: 600 900; font-style: italic; }
@font-face { font-family: "Lexend"; src: url("{{ assets }}/fonts/Lexend.ttf"); font-weight: 100 900; font-style: normal; }

:root {
  --navy: #0E2238; --paper: #F4F0E8; --ink: #0F1A26; --muted: #5E6673; --sky: #6CC0EE; --blue: #1C6CA8; --land: #E1D9C9;
  --serif: "Libron", Georgia, serif; --sans: "Lexend", Arial, sans-serif;
  --ease: cubic-bezier(.2, .8, .2, 1); --spring: cubic-bezier(.3, 1.45, .5, 1);
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { width: 1080px; height: 1920px; overflow: hidden; background: #000; }
body { font-family: var(--sans); -webkit-font-smoothing: antialiased; }
#stage { position: relative; width: 1080px; height: 1920px; overflow: hidden; }

/* Instagram covers the top ~220px, the bottom ~420px and the right edge of the lower half:
   everything that must be read stays between y 240 and 1480, and below y 960 left of x 900. */
.scene { position: absolute; inset: 0; overflow: hidden; opacity: 0; animation: show 100s step-end var(--at) none; }
.scene.wipeR { animation: show 100s step-end var(--at) none, wipeR .42s var(--ease) var(--at) both; }
.scene.wipeU { animation: show 100s step-end var(--at) none, wipeU .45s var(--ease) var(--at) both; }
@keyframes show { from, to { opacity: 1; } }
@keyframes wipeR { from { clip-path: inset(0 0 0 100%); } to { clip-path: inset(0); } }
@keyframes wipeU { from { clip-path: inset(100% 0 0 0); } to { clip-path: inset(0); } }
.navy { background: var(--navy); color: var(--paper); }
.paper { background: var(--paper); color: var(--ink); }

.up { animation: up .6s var(--ease) var(--t, 0s) both; }
.pop { animation: pop .5s var(--spring) var(--t, 0s) both; }
.fade { animation: fade .45s ease var(--t, 0s) both; }
.settle { animation: settle .9s var(--ease) 0s both; }
@keyframes up { from { opacity: 0; transform: translateY(46px); } }
@keyframes pop { from { opacity: 0; transform: scale(.55); } to { opacity: 1; transform: scale(1); } }
@keyframes fade { from { opacity: 0; } }
@keyframes settle { from { transform: scale(1.05); } }

.pad { position: absolute; left: 80px; right: 80px; }
.serif { font-family: var(--serif); font-weight: 600; letter-spacing: -0.014em; line-height: 1.0; text-wrap: balance; }
.serif em { font-style: italic; font-weight: 500; }
.kicker { font-weight: 600; font-size: 30px; letter-spacing: .13em; text-transform: uppercase; }
.lede { font-size: 46px; line-height: 1.3; font-weight: 400; }

.waves { position: absolute; left: -200px; right: -200px; bottom: 0; height: 360px; opacity: .13; color: var(--sky); animation: drift 6s linear 0s infinite; }
.waves svg { width: 100%; height: 100%; display: block; }
@keyframes drift { to { transform: translateX(-200px); } }

/* map */
.map { display: block; width: 100%; height: 100%; }
.map path { vector-effect: non-scaling-stroke; }
.map .d { fill: var(--land); stroke: var(--paper); stroke-width: 1.5; }
.map .d.on { fill: var(--blue); }
.map.all .d { fill: color-mix(in srgb, var(--blue) 45%, var(--land)); }
.map .target .r2, .map .target .x, .map .target .r1 { display: none; }
.map .target .c { fill: #fff; stroke: var(--ink); stroke-width: 3; vector-effect: non-scaling-stroke; }
.map .pins rect { fill: var(--sky); }
.map .pins text { font-family: var(--sans); font-weight: 700; font-size: 28px; fill: var(--navy); }
.map .lead { stroke: var(--sky); stroke-width: 2; vector-effect: non-scaling-stroke; }
.map .dot { fill: var(--sky); }
.cover .map .d { fill: rgba(244, 240, 232, .12); stroke: var(--navy); }
.cover .map .d.on { fill: rgba(108, 192, 238, .55); }

/* cover */
.cover .k { top: 300px; color: var(--sky); }
.cover h1 { top: 372px; font-size: 172px; line-height: .92; }
.cover h1 em { color: var(--sky); }
.cover .lede { top: 790px; opacity: .92; }
.cover .mapw { position: absolute; left: 60px; top: 960px; width: 820px; height: 456px; }

/* story */
.bars { top: 252px; display: flex; gap: 12px; }
.bars i { flex: 1; height: 8px; border-radius: 4px; background: rgba(15, 26, 38, .14); overflow: hidden; }
.bars i b { display: block; width: 0; height: 100%; background: var(--blue); }
.bars i.done b { width: 100%; }
.bars i.now b { width: 0; animation: grow var(--len) linear var(--at) both; }
@keyframes grow { to { width: 100%; } }
.story .k { top: 300px; color: var(--blue); display: flex; gap: 18px; align-items: baseline; }
.story .k .n { font-family: var(--serif); font-size: 64px; letter-spacing: -0.02em; text-transform: none; line-height: 1; }
.story h2 { top: 392px; height: 384px; font-size: 112px; line-height: 1.0; display: flex; align-items: flex-start; }
.story h2 span { display: block; }
.stat { top: 812px; padding-left: 34px; border-left: 8px solid var(--blue); }
.stat .v { font-family: var(--serif); font-weight: 600; font-size: 200px; line-height: .95; color: var(--blue); letter-spacing: -0.02em; white-space: nowrap; overflow: hidden; }
.stat .l { font-size: 40px; line-height: 1.3; color: var(--muted); margin-top: 14px; max-width: 760px; }
.whyb { top: 812px; right: 180px; font-size: 48px; line-height: 1.32; color: var(--ink); padding-left: 34px; border-left: 8px solid var(--blue); }
.story .mapw { position: absolute; left: 80px; top: 1250px; width: 380px; height: 212px; }
.story .loc { position: absolute; left: 500px; top: 1290px; width: 380px; font-size: 34px; line-height: 1.3; color: var(--muted); }
.story .loc b { display: block; color: var(--ink); font-weight: 600; font-size: 40px; }

/* closing card */
.cta .logo { top: 270px; font-family: var(--serif); font-weight: 600; font-size: 176px; line-height: .9; letter-spacing: -0.02em; }
.cta .logo em { font-style: italic; font-weight: 500; color: var(--sky); }
.cta .sub { top: 610px; font-size: 44px; line-height: 1.3; opacity: .92; }
.cta .times { top: 790px; list-style: none; right: 180px; }
.cta .times li { display: grid; grid-template-columns: 170px 1fr; align-items: baseline; padding: 20px 0 22px; border-top: 1px solid rgba(255, 255, 255, .2); }
.cta .times li:last-child { border-bottom: 1px solid rgba(255, 255, 255, .2); }
.cta .times b { font-size: 38px; font-weight: 600; color: var(--sky); font-variant-numeric: tabular-nums; }
.cta .times span { font-family: var(--serif); font-size: 54px; font-weight: 500; line-height: 1; }
.cta .row { top: 1230px; display: flex; align-items: center; gap: 34px; }
.cta .pulse { animation: pulse 1.1s ease-in-out var(--p) infinite; }
@keyframes pulse { 50% { transform: scale(1.06); } }
.cta .follow { position: relative; display: inline-flex; align-items: center; gap: 16px; background: var(--sky); color: var(--navy);
  font-size: 50px; font-weight: 700; padding: 26px 50px 28px 40px; border-radius: 999px; }
.cta .follow svg { width: 46px; height: 46px; }
.cta .handle { font-family: var(--serif); font-size: 58px; font-weight: 600; }
.cta .ripple { position: absolute; left: 50%; top: 50%; width: 160px; height: 160px; margin: -80px 0 0 -80px; border-radius: 50%;
  border: 6px solid var(--sky); animation: ripple 1.1s ease-out var(--p) infinite; }
@keyframes ripple { from { transform: scale(.4); opacity: .9; } to { transform: scale(3.2); opacity: 0; } }
</style>
</head>
<body>
{%- macro waves() -%}
<div class="waves"><svg viewBox="0 0 1480 360" preserveAspectRatio="none" fill="none" stroke="currentColor" stroke-width="3">
{%- for i in range(8) %}{% set y = 40 + i * 42 %}<path d="M-20 {{ y }} C 180 {{ y - 40 }}, 380 {{ y + 40 }}, 580 {{ y }} S 980 {{ y - 40 }}, 1180 {{ y }} S 1380 {{ y + 40 }}, 1500 {{ y }}"/>{% endfor -%}
</svg></div>
{%- endmacro %}
<div id="stage">

  <section class="scene navy cover" style="--at:0s">
    {{ waves() }}
    <div class="pad kicker k up" style="--t:.1s">{{ date_label }}</div>
    <h1 class="pad serif settle">Samsun'da<br><em>bugün</em></h1>
    <div class="pad lede up" style="--t:.35s">Günün {{ stories|length }} haberi, {{ seconds }} saniyede.</div>
    <div class="mapw fade" style="--t:.5s">{{ cover_map }}</div>
  </section>

  {%- for s in scenes %}
  <section class="scene paper story wipeR" style="--at:{{ s.at }}s; --len:{{ s.len }}s">
    {%- set cur = loop.index0 %}{# inside the bar loop, `loop` is the bar's own loop #}
    <div class="pad bars">{% for j in range(scenes|length) %}<i class="{{ 'done' if j < cur else ('now' if j == cur else 'todo') }}"><b></b></i>{% endfor %}</div>
    {%- set t = s.at %}
    <div class="pad kicker k up" style="--t:{{ '%.2f' % (t + 0.15) }}s"><span class="n">{{ '%02d' % s.n }}</span><span>{{ s.category }}</span></div>
    <h2 class="pad serif up" style="--t:{{ '%.2f' % (t + 0.25) }}s"><span data-fit-h="384" data-min="64">{{ s.title }}</span></h2>
    {%- if s.stat %}
    <div class="pad stat up" style="--t:{{ '%.2f' % (t + 0.55) }}s"><div class="v" data-fit-w="1" data-min="96">{{ s.stat.value }}</div><div class="l">{{ s.stat.label }}</div></div>
    {%- else %}
    <div class="pad whyb up" style="--t:{{ '%.2f' % (t + 0.55) }}s" data-fit-h="400" data-min="34">{{ s.why }}</div>
    {%- endif %}
    <div class="mapw fade" style="--t:{{ '%.2f' % (t + 0.8) }}s">{{ s.map }}</div>
    <div class="loc up" style="--t:{{ '%.2f' % (t + 0.9) }}s"><b>{{ s.place }}</b>{{ s.location }}</div>
  </section>
  {%- endfor %}

  <section class="scene navy cta wipeU" style="--at:{{ cta_at }}s">
    {{ waves() }}
    <div class="pad logo up" style="--t:{{ '%.2f' % (cta_at + 0.15) }}s">Bugün<br><em>Samsun</em></div>
    <div class="pad sub up" style="--t:{{ '%.2f' % (cta_at + 0.45) }}s">Günün bütün haberleri profildeki bültende.</div>
    <ul class="pad times">
      <li class="up" style="--t:{{ '%.2f' % (cta_at + 0.7) }}s"><b>08.00</b><span>Gündem</span></li>
      <li class="up" style="--t:{{ '%.2f' % (cta_at + 0.85) }}s"><b>12.30</b><span>Ekonomi &amp; İş</span></li>
      <li class="up" style="--t:{{ '%.2f' % (cta_at + 1.0) }}s"><b>19.00</b><span>Spor</span></li>
    </ul>
    <div class="pad row">
      <div class="pop" style="--t:{{ '%.2f' % (cta_at + 1.3) }}s"><div class="pulse" style="--p:{{ '%.2f' % (cta_at + 1.9) }}s">
        <div class="follow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>Takip et<i class="ripple" style="--p:{{ '%.2f' % (cta_at + 1.9) }}s"></i></div>
      </div></div>
      <div class="handle up" style="--t:{{ '%.2f' % (cta_at + 1.5) }}s">@bugunsamsun</div>
    </div>
  </section>

</div>
<script>
// Fit long titles and numbers before any frame is taken (layout ignores the entrance transforms).
window.__fit = () => {
  let bad = 0;
  document.querySelectorAll('[data-fit-h]').forEach(el => {
    const box = +el.dataset.fitH, min = +el.dataset.min;
    let size = parseFloat(getComputedStyle(el).fontSize);
    while (el.scrollHeight > box && size > min) { size -= 2; el.style.fontSize = size + 'px'; }
    if (el.scrollHeight > box) bad++;
  });
  document.querySelectorAll('[data-fit-w]').forEach(el => {
    const min = +el.dataset.min;
    let size = parseFloat(getComputedStyle(el).fontSize);
    while (el.scrollWidth > el.clientWidth + 1 && size > min) { size -= 4; el.style.fontSize = size + 'px'; }
    if (el.scrollWidth > el.clientWidth + 1) bad++;
  });
  return bad;
};
window.seek = (ms) => { for (const a of document.getAnimations()) { a.pause(); a.currentTime = ms; } };
window.DURATION = {{ duration }};
</script>
</body>
</html>
