<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<title>Samsun Bülten</title>
<style>
{% if fontset == 'libron' %}
@font-face { font-family: "Libron"; src: url("{{ assets }}/fonts/Libron-Regular.ttf"); font-weight: 100 500; font-style: normal; }
@font-face { font-family: "Libron"; src: url("{{ assets }}/fonts/Libron-Bold.ttf"); font-weight: 600 900; font-style: normal; }
@font-face { font-family: "Libron"; src: url("{{ assets }}/fonts/Libron-Italic.ttf"); font-weight: 100 500; font-style: italic; }
@font-face { font-family: "Libron"; src: url("{{ assets }}/fonts/Libron-BoldItalic.ttf"); font-weight: 600 900; font-style: italic; }
@font-face { font-family: "Lexend"; src: url("{{ assets }}/fonts/Lexend.ttf"); font-weight: 100 900; font-style: normal; }
{% else %}
@font-face { font-family: "Newsreader"; src: url("{{ assets }}/fonts/Newsreader.ttf") format("truetype"); font-weight: 200 800; font-style: normal; }
@font-face { font-family: "Newsreader"; src: url("{{ assets }}/fonts/Newsreader-Italic.ttf") format("truetype"); font-weight: 200 800; font-style: italic; }
@font-face { font-family: "Inter"; src: url("{{ assets }}/fonts/Inter.ttf") format("truetype"); font-weight: 100 900; font-style: normal; }
{% endif %}

:root {
  --paper: #F4F0E8; --card: #FBF9F4; --ink: #0F1A26; --muted: #5E6673; --rule: rgba(15, 26, 38, .14);
  --land: #E1D9C9;
{% if fontset == 'libron' %}
  --serif: "Libron", Georgia, serif; --sans: "Lexend", "Helvetica Neue", Arial, sans-serif; --tk: .62; --sans-scale: .94;
{% else %}
  --serif: "Newsreader", Georgia, serif; --sans: "Inter", "Helvetica Neue", Arial, sans-serif; --tk: 1; --sans-scale: 1;
{% endif %}
}
.ed-gundem  { --cover-bg: #0E2238; --cover-ink: #F4F0E8; --cover-accent: #6CC0EE; --accent: #1C6CA8; --accent-soft: #E3ECF4; }
.ed-ekonomi { --cover-bg: #0C3A2D; --cover-ink: #F4F0E8; --cover-accent: #E5B947; --accent: #0E7C5A; --accent-soft: #E1EFE8; }
.ed-spor    { --cover-bg: #B5121B; --cover-ink: #FFFFFF; --cover-accent: #FFFFFF; --accent: #C8102E; --accent-soft: #F7E3E3; }

* { box-sizing: border-box; margin: 0; padding: 0; }
body { background: #888; font-family: var(--sans); -webkit-font-smoothing: antialiased; }
.slide {
  position: relative; width: 1080px; height: 1350px; overflow: hidden; margin-bottom: 40px;
  display: flex; flex-direction: column; padding: 72px 80px 58px;
  background: var(--paper); color: var(--ink);
}
.slide.dark { background: var(--cover-bg); color: var(--cover-ink); }
.slide > * { position: relative; }
.sample { position: absolute; top: 30px; left: -60px; transform: rotate(-35deg); background: #FFD400; color: #111;
  font: 700 17px/1 var(--sans); letter-spacing: calc(.2em * var(--tk)); padding: 9px 70px; z-index: 10; }

/* ---------- shared ---------- */
.logo { font-family: var(--serif); font-weight: 600; font-size: 46px; letter-spacing: -0.01em; line-height: 1; font-variation-settings: "opsz" 72; }
.logo em { font-style: italic; font-weight: 500; }
.pill { font-weight: 600; font-size: 20px; letter-spacing: calc(.14em * var(--tk)); text-transform: uppercase; border: 2px solid currentColor; border-radius: 999px; padding: 8px 18px 7px; line-height: 1; }
.rule { height: 2px; background: currentColor; opacity: .9; margin-top: 26px; }
.rule.thin { height: 1px; opacity: .2; margin-top: 22px; }
.content { flex: 1 1 auto; min-height: 0; overflow: hidden; display: flex; flex-direction: column; }
.spacer { flex: 1 1 32px; min-height: 32px; }

/* top-right stays empty: Instagram draws its own 1/N badge there */
.dateline { display: flex; justify-content: space-between; align-items: center; margin-top: 18px; font-size: 25px; font-weight: 500; }
.dateline .r { display: flex; align-items: center; gap: 16px; opacity: .9; }

.footer { margin-top: auto; padding-top: 26px; display: flex; align-items: flex-end; justify-content: space-between; gap: 40px; font-size: 21px; line-height: 1.35; }
.footer .left { color: var(--muted); max-width: 740px; }
.dark .footer .left { color: inherit; opacity: .8; }
.footer .right { display: flex; align-items: flex-end; gap: 22px; }
.count { font-size: 21px; font-weight: 600; color: var(--muted); font-variant-numeric: tabular-nums; letter-spacing: calc(.04em * var(--tk)); padding-bottom: 6px; }
.mark { width: 46px; height: 46px; flex: none; color: var(--ink); }
.dark .mark { color: var(--cover-ink); }
.mark svg { width: 100%; height: 100%; display: block; }

.waves { position: absolute; left: 0; right: 0; bottom: 0; height: 300px; color: var(--cover-accent); opacity: .13; pointer-events: none; }
.waves svg { width: 100%; height: 100%; display: block; }

/* ---------- cover ---------- */
.cover .hero { display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; margin-top: 50px; }
.cover h1 { font-family: var(--serif); font-weight: 500; font-size: 116px; line-height: .94; letter-spacing: -0.025em; font-variation-settings: "opsz" 72; }
.cover h1 em { font-style: italic; color: var(--cover-accent); }
.weather { display: flex; align-items: center; gap: 16px; padding-bottom: 10px; flex: none; }
.weather > svg { width: 64px; height: 64px; color: var(--cover-accent); }
.weather .t { font-family: var(--serif); font-size: 52px; font-weight: 500; line-height: 1; }
.weather .t small { font-size: 32px; opacity: .7; }
.weather .d { font-size: 21px; opacity: .8; margin-top: 6px; }
.headlines { list-style: none; margin-top: 40px; }
.headlines li { display: grid; grid-template-columns: 74px 1fr; align-items: baseline; padding: 18px 0 20px; border-top: 1px solid rgba(255,255,255,.18); }
.headlines li:last-child { border-bottom: 1px solid rgba(255,255,255,.18); }
.headlines .n { font-weight: 600; font-size: 24px; color: var(--cover-accent); letter-spacing: calc(.04em * var(--tk)); font-variant-numeric: tabular-nums; }
.headlines .k { display: block; font-size: 17px; font-weight: 600; letter-spacing: calc(.14em * var(--tk)); text-transform: uppercase; opacity: .6; margin-bottom: 6px; }
.headlines li:first-child .k { opacity: 1; color: var(--cover-accent); }
.headlines .h { display: block; font-family: var(--serif); font-weight: 500; font-size: 41px; line-height: 1.14; letter-spacing: -0.008em; font-variation-settings: "opsz" 36; }
.cover .footer, .outro .footer { font-size: 24px; font-weight: 500; }
.swipe { display: flex; align-items: center; gap: 14px; }
.swipe svg { width: 32px; height: 32px; color: var(--cover-accent); }
.schedule { display: block; font-size: 21px; font-weight: 500; opacity: .7; margin-top: 8px; }
.scoreboard { margin-top: 36px; border: 2px solid rgba(255,255,255,.55); border-radius: 22px; padding: 22px 32px 26px; }
.scoreboard .comp { font-size: 19px; font-weight: 600; letter-spacing: calc(.14em * var(--tk)); text-transform: uppercase; opacity: .85; }
.scoreboard .row { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 24px; margin-top: 10px; }
.scoreboard .team { font-size: 34px; font-weight: 700; letter-spacing: calc(.02em * var(--tk)); text-transform: uppercase; line-height: 1.1; }
.scoreboard .team.away { text-align: right; }
.scoreboard .score { font-family: var(--serif); font-size: 96px; font-weight: 600; line-height: 1; font-variant-numeric: tabular-nums; }

/* ---------- inner pages ---------- */
.topbar { display: flex; align-items: baseline; gap: 14px; }
.topbar .logo { font-size: 32px; }
.topbar .ed { font-size: 21px; font-weight: 600; color: var(--accent); letter-spacing: calc(.12em * var(--tk)); text-transform: uppercase; }

.meta { display: flex; align-items: center; justify-content: space-between; gap: 30px; margin-top: 40px; }
.meta .tags { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
.chip { display: inline-flex; align-items: center; gap: 10px; background: var(--accent); color: #fff; font-weight: 600; font-size: 21px; letter-spacing: calc(.12em * var(--tk)); text-transform: uppercase;
  padding: 11px 18px 10px; border-radius: 8px; line-height: 1; }
.chip svg { width: 24px; height: 24px; }
.chip.ink { background: var(--ink); }
.place { display: flex; align-items: center; gap: 8px; font-size: 24px; font-weight: 500; color: var(--muted); }
.place svg { width: 24px; height: 24px; }

/* small light locator map — context, not decoration */
.locator { flex: none; width: 230px; text-align: right; }
.locator .mapw { width: 230px; height: 128px; }
.locator .lbl { font-size: 17px; font-weight: 600; letter-spacing: calc(.14em * var(--tk)); text-transform: uppercase; color: var(--muted); margin-top: 4px; }
.locator .lbl b { color: var(--accent); }
.lead .locator { width: 270px; }
.lead .locator .mapw { width: 270px; height: 150px; }
.map { display: block; width: 100%; height: 100%; }
.map path { vector-effect: non-scaling-stroke; }
.map .d { fill: var(--land); stroke: var(--paper); stroke-width: 1.3; }
.map .d.on { fill: var(--accent); }
.map.all .d { fill: color-mix(in srgb, var(--accent) 45%, var(--land)); }
.map .target .r2, .map .target .x, .map .target .r1 { display: none; }
.map .target .c { fill: #fff; stroke: var(--ink); stroke-width: 3; vector-effect: non-scaling-stroke; }

h2 { font-family: var(--serif); font-weight: 600; letter-spacing: -0.018em; font-variation-settings: "opsz" 72; text-wrap: balance; }
.story h2 { font-size: 70px; line-height: 1.05; margin-top: 30px; }
.lead h2 { font-size: 86px; line-height: 1.0; margin-top: 30px; }
.stat { margin-top: 34px; padding: 4px 0 6px 28px; border-left: 6px solid var(--accent); }
.stat .v { display: block; font-family: var(--serif); font-weight: 600; font-size: 92px; line-height: .95; color: var(--accent); letter-spacing: -0.02em; }
.stat .l { display: block; font-size: 25px; line-height: 1.3; color: var(--muted); font-weight: 500; margin-top: 10px; }
.lead .stat .v { font-size: 116px; }
.split { display: grid; grid-template-columns: 290px 1fr; gap: 40px; align-items: start; margin-top: 40px; padding-top: 34px; border-top: 1px solid var(--rule); }
.split .stat { margin-top: 0; }
.split .body { margin-top: 0; }
.body { margin-top: 34px; font-size: 32px; line-height: 1.47; color: var(--ink); }
.body p + p { margin-top: 18px; }
.why { background: var(--accent-soft); border-radius: 18px; padding: 26px 30px 28px; }
.why .k { font-size: 19px; font-weight: 700; letter-spacing: calc(.16em * var(--tk)); text-transform: uppercase; color: var(--accent); }
.why .t { font-size: 29px; line-height: 1.42; font-weight: 500; margin-top: 10px; }

/* ---------- briefs ---------- */
.ptitle { font-family: var(--serif); font-weight: 600; font-size: 96px; line-height: 1; letter-spacing: -0.02em; margin-top: 46px; font-variation-settings: "opsz" 72; }
.ptitle em { font-style: italic; font-weight: 500; color: var(--accent); }
.psub { font-size: 25px; color: var(--muted); margin-top: 14px; font-weight: 500; }
.briefs ul { list-style: none; margin-top: 34px; }
.briefs li { padding: 24px 0; border-top: 1px solid var(--rule); }
.briefs li:last-child { border-bottom: 1px solid var(--rule); }
.briefs li .k { font-size: 18px; font-weight: 700; letter-spacing: calc(.14em * var(--tk)); text-transform: uppercase; color: var(--accent); }
.briefs li .k span { color: var(--muted); font-weight: 600; }
.briefs li .t { font-size: 31px; line-height: 1.4; margin-top: 8px; font-weight: 500; }

/* ---------- practical ---------- */
.guide { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-top: 34px; }
.box { background: var(--card); border: 1px solid var(--rule); border-radius: 18px; padding: 24px 26px 26px; }
.box .k { display: flex; align-items: center; gap: 10px; font-size: 18px; font-weight: 700; letter-spacing: calc(.14em * var(--tk)); text-transform: uppercase; color: var(--accent); }
.box .k svg { width: 26px; height: 26px; }
.box .big { font-family: var(--serif); font-weight: 600; font-size: 92px; line-height: 1; margin-top: 12px; letter-spacing: -0.02em; }
.box .big small { font-size: .5em; color: var(--muted); font-weight: 500; }
.box .t { font-size: 25px; line-height: 1.4; margin-top: 10px; color: var(--ink); font-weight: 500; }
.box .t b { font-weight: 700; }
.box .src { font-size: 17px; color: var(--muted); margin-top: 8px; }
.box.wide { grid-column: 1 / -1; }
.box.sun .pair { display: flex; gap: 40px; margin-top: 12px; }
.box.sun .pair div { font-family: var(--serif); font-weight: 600; font-size: 60px; line-height: 1; }
.box.sun .pair small { display: block; font-family: var(--sans); font-size: 17px; font-weight: 600; letter-spacing: calc(.12em * var(--tk)); color: var(--muted); margin-top: 6px; }
.box.alert { background: var(--accent-soft); border-color: transparent; }

/* ---------- outro ---------- */
.outro .big { font-family: var(--serif); font-weight: 500; font-size: 124px; line-height: .95; letter-spacing: -0.03em; margin-top: 110px; font-variation-settings: "opsz" 72; }
.outro .big em { font-style: italic; color: var(--cover-accent); }
.outro .sub { font-size: 34px; line-height: 1.35; margin-top: 30px; opacity: .9; }
.acts { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 64px; border-top: 1px solid rgba(255,255,255,.25); }
.acts > div { padding: 28px 18px 0 0; }
.acts > div + div { padding-left: 26px; border-left: 1px solid rgba(255,255,255,.18); }
.acts svg { width: 44px; height: 44px; color: var(--cover-accent); }
.acts .h { font-family: var(--serif); font-weight: 600; font-size: 40px; margin-top: 12px; }
.acts .t { font-size: 21px; opacity: .75; margin-top: 6px; line-height: 1.35; }
.outro .handle { margin-top: 52px; }
.outro .handle .k { font-size: 20px; font-weight: 600; letter-spacing: calc(.14em * var(--tk)); text-transform: uppercase; opacity: .75; }
.outro .handle .h { font-family: var(--serif); font-size: 72px; font-weight: 600; margin-top: 8px; letter-spacing: -0.01em; }
.outro .times { display: flex; gap: 34px; font-size: 24px; font-weight: 500; opacity: .9; }
.outro .times b { color: var(--cover-accent); font-weight: 700; }
{% if fontset == 'libron' %}
/* Lexend runs wide and dark: lighter weights for running text, tighter display tracking for Libron */
.briefs li .t, .why .t, .box .t, .psub, .acts .t, .outro .sub, .place { font-weight: 400; }
.body { line-height: 1.5; }
h2, .cover h1, .ptitle, .outro .big { letter-spacing: -0.012em; }
{% endif %}
</style>
</head>
<body>
{%- set CROP = "-10 58 970 540" -%}
{%- macro mark() -%}<div class="mark">{{ mark_svg }}</div>{%- endmacro -%}
{%- macro waves() -%}
<div class="waves"><svg viewBox="0 0 1080 300" preserveAspectRatio="none" fill="none" stroke="currentColor" stroke-width="3">
{%- for i in range(7) %}<path d="M-20 {{ 40 + i*38 }} C 160 {{ i*38 }}, 340 {{ 80 + i*38 }}, 520 {{ 40 + i*38 }} S 880 {{ i*38 }}, 1100 {{ 40 + i*38 }}"/>{%- endfor %}
</svg></div>
{%- endmacro -%}
{%- macro sample_tag() -%}{% if sample %}<div class="sample">ÖRNEK</div>{% endif %}{%- endmacro -%}
{%- macro place(d) -%}{{ d if d and d != 'Samsun' else 'Samsun geneli' }}{%- endmacro -%}
{%- macro topbar() -%}<div class="topbar"><span class="logo">Samsun <em>Bülten</em></span><span class="ed">{{ ed.label }}</span></div><div class="rule thin"></div>{%- endmacro -%}
{%- macro footer(src, idx) -%}<div class="footer"><div class="left">{{ src }}</div><div class="right"><span class="count">{{ '%02d' % idx }} / {{ '%02d' % total }}</span>{{ mark() }}</div></div>{%- endmacro -%}
{%- macro locator(st) -%}
  <div class="locator">
    <div class="mapw">{% if st.district in districts_with_news %}{{ map_svg(highlight=[st.district], vb=CROP, target=st.district, context=False, zoom='auto') }}{% else %}{{ map_svg(vb=CROP, context=False, cls='map all') }}{% endif %}</div>
    <div class="lbl"><b>{{ place(st.district) }}</b></div>
  </div>
{%- endmacro -%}

{% for s in slides %}
{% if s.kind == 'cover' %}
<section class="slide dark cover ed-{{ edition }}" data-idx="{{ s.idx }}" data-grow="1.25">
  {{ waves() }}{{ sample_tag() }}
  <div class="logo">Samsun <em>Bülten</em></div>
  <div class="rule"></div>
  <div class="dateline"><span>{{ day }} {{ month }} {{ year }}, {{ weekday }}</span><span class="r"><span class="pill">{{ ed.label }}</span><span>Sayı {{ '%03d' % issue_no }}</span></span></div>
  <div class="content fit-box">
    <div class="hero">
      <h1>{{ ed.title_html | safe }}</h1>
      {% if weather %}
      <div class="weather">{{ icon(weather.icon, 1.7) }}<div><div class="t">{{ weather.max }}°<small> / {{ weather.min }}°</small></div><div class="d">{{ weather.text }}</div></div></div>
      {% endif %}
    </div>
    {% if scoreboard %}
    <div class="scoreboard">
      <div class="comp">{{ scoreboard.competition }}</div>
      <div class="row"><div class="team">{{ scoreboard.home }}</div><div class="score">{{ scoreboard.home_score }}–{{ scoreboard.away_score }}</div><div class="team away">{{ scoreboard.away }}</div></div>
    </div>
    {% endif %}
    <ol class="headlines">
      {% for st in s.stories %}
      <li><span class="n">{{ '%02d' % st.n }}</span><span><span class="k">{{ 'Manşet · ' if loop.first else '' }}{{ place(st.district) }}</span><span class="h" data-fit="30" data-max="46">{{ st.short_title }}</span></span></li>
      {% endfor %}
    </ol>
  </div>
  <div class="footer">
    <div class="left">
      <span class="swipe">Detaylar için kaydır {{ icon('arrow', 2.4) }}</span>
      <span class="schedule">{{ reading_min }} dk okuma · {{ ed.schedule }}</span>
    </div>
    {{ mark() }}
  </div>
</section>

{% elif s.kind in ('lead', 'story') %}
{% set st = s.story %}
<section class="slide {{ s.kind }} ed-{{ edition }}" data-idx="{{ s.idx }}">
  {{ sample_tag() }}
  {{ topbar() }}
  <div class="content fit-box">
    <div class="meta">
      <div class="tags">
        {% if s.kind == 'lead' %}<span class="chip ink">Manşet</span>{% endif %}
        <span class="chip">{{ st.icon }}{{ st.category }}</span>
        {% if st.location %}<span class="place">{{ icon('pin', 2) }}{{ st.location }}</span>{% endif %}
      </div>
      {{ locator(st) }}
    </div>
    <h2 data-fit="52" data-max="{{ (90 if s.kind == 'lead' else 80) if fontset == 'libron' else (96 if s.kind == 'lead' else 86) }}">{{ st.title }}</h2>
    {% if s.kind == 'lead' and st.stat and st.stat.value %}
    <div class="split">
      <div class="stat"><span class="v" data-fit="70" data-max="128">{{ st.stat.value }}</span><span class="l">{{ st.stat.label }}</span></div>
      <div class="body" data-fit="27" data-max="38">{% for p in st.body_paragraphs %}<p>{{ p }}</p>{% endfor %}</div>
    </div>
    {% else %}
    {% if st.stat and st.stat.value %}
    <div class="stat"><span class="v" data-fit="60" data-max="112">{{ st.stat.value }}</span><span class="l">{{ st.stat.label }}</span></div>
    {% endif %}
    <div class="body" data-fit="27" data-max="40">{% for p in st.body_paragraphs %}<p>{{ p }}</p>{% endfor %}</div>
    {% endif %}
    <div class="spacer"></div>
    {% if st.why %}<div class="why"><div class="k">Neden önemli</div><div class="t" data-fit="22" data-max="34">{{ st.why }}</div></div>{% endif %}
  </div>
  {{ footer('Kaynak: ' ~ st.sources|join(', '), s.idx) }}
</section>

{% elif s.kind == 'briefs' %}
<section class="slide briefs ed-{{ edition }}" data-idx="{{ s.idx }}" data-grow="1.45">
  {{ sample_tag() }}
  {{ topbar() }}
  <div class="content fit-box">
    <div class="ptitle">Kısa <em>kısa</em></div>
    <div class="psub">Bir cümlede bilmen gerekenler</div>
    <ul>
      {% for b in s.briefs %}
      <li><div class="k">{{ place(b.district) }} <span>· {{ b.category }}</span></div><div class="t" data-fit="24" data-max="44">{{ b.text }}</div></li>
      {% endfor %}
    </ul>
  </div>
  {{ footer('Kaynak: ' ~ s.sources|join(', '), s.idx) }}
</section>

{% elif s.kind == 'practical' %}
<section class="slide practical ed-{{ edition }}" data-idx="{{ s.idx }}">
  {{ sample_tag() }}
  {{ topbar() }}
  <div class="content fit-box">
    <div class="ptitle">Gün <em>rehberi</em></div>
    <div class="psub">Kaydet, gün içinde lazım olur</div>
    <div class="guide">
      {% if weather %}
      <div class="box"><div class="k">{{ icon(weather.icon, 2) }}Hava</div><div class="big">{{ weather.max }}°<small> / {{ weather.min }}°</small></div><div class="t">{{ weather.text }}<br>Yağış %{{ weather.rain }} · Rüzgâr {{ weather.wind }} km/sa</div></div>
      <div class="box"><div class="k">{{ icon('waves', 2) }}Deniz suyu</div><div class="big">{{ weather.sea if weather.sea is not none else '–' }}°</div><div class="t">Samsun açıkları<br>yüzey sıcaklığı</div></div>
      <div class="box wide sun"><div class="k">{{ icon('sunrise', 2) }}Güneş</div><div class="pair"><div>{{ weather.sunrise }}<small>DOĞUŞ</small></div><div>{{ weather.sunset }}<small>BATIŞ</small></div></div></div>
      {% endif %}
      {% for o in practical.outages %}
      <div class="box wide alert"><div class="k">{{ icon(o.kind, 2) }}{{ o.title }}</div><div class="t">{{ o.text }}</div><div class="src">Kaynak: {{ o.source }}</div></div>
      {% endfor %}
      {% if practical.pharmacy %}<div class="box wide"><div class="k">{{ icon('pharmacy', 2) }}Nöbetçi eczane</div><div class="t">{{ practical.pharmacy }}</div></div>{% endif %}
    </div>
  </div>
  {{ footer('Hava ve deniz verisi: Open-Meteo', s.idx) }}
</section>

{% elif s.kind == 'outro' %}
